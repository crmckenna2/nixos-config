{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nix-manager": {
      "type": "local",
      "command": [
        "nix-shell",
        "-p",
        "python3Packages.mcp",
        "--run",
        "python3 /home/llm/.config/opencode/mcp/nix_mcp.py"
      ],
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": {
      "apt *": "deny",
      "apt-get *": "deny",
      "dnf *": "deny",
      "pacman *": "deny", "sudo *": "deny",
      "brew *": "deny",
      "nix-env *": "deny",
      "nix profile install*": "deny",
      "*": "allow"
    }
  }
}
